# Private Google Sheet that contains the cycling data.
STRAVA_SHEET_ID=your-cycling-data-spreadsheet-id

# Optional: set a specific tab and range, e.g. 'Activities'!A:K.
# Leave blank to let the server discover the first tab and read columns A:K.
STRAVA_SHEET_RANGE=

# Keyless Vercel Workload Identity Federation. No service-account key is used.
# Give this service account Viewer access to the cycling data Sheet.
GCP_SERVICE_ACCOUNT_EMAIL=ridescope-server@your-project.iam.gserviceaccount.com
GCP_PROJECT_NUMBER=123456789012
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional server port (defaults to 8787).
PORT=8787

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback

# Required for signed session cookies. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Your read-only cycling data Sheet. Share it with the service account as Viewer.
STRAVA_SHEET_ID=1ystGRESsSCnH5v6IBgA52GSH0G0UB1zk6f1v96fl7_o

# Optional: default range if you know the tab name.
# Leave blank to let the server discover the first sheet tab.
STRAVA_SHEET_RANGE=

# Server-owned service account. Share the cycling data Sheet as Viewer and a
# separate sign-in log spreadsheet as Editor with this service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=ridescope-server@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Create this spreadsheet in your account with a tab named Sign-ins and row 1:
# Email | Signed in at (UTC). The server appends one row per successful sign-in.
SIGNIN_LOG_SHEET_ID=your-sign-in-log-spreadsheet-id
SIGNIN_LOG_SHEET_RANGE='Sign-ins'!A:B

# Optional server port (defaults to 8787).
PORT=8787

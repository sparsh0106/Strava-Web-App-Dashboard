# Pooled PostgreSQL connection string from your Neon project or Vercel integration.
# Keep the real value in .env.local / Vercel Environment Variables, never in git.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random bearer token required by the Android Samsung Health uploader.
SYNC_TOKEN=replace-with-a-long-random-secret

# Optional local Express port (defaults to 8787).
PORT=8787

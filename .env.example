# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback

# Required for signed session cookies. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Your Google Sheet ID
STRAVA_SHEET_ID=1ystGRESsSCnH5v6IBgA52GSH0G0UB1zk6f1v96fl7_o

# Optional: default range if you know the tab name.
# Leave blank to let the server discover the first sheet tab.
STRAVA_SHEET_RANGE=

# Optional server port (defaults to 8787).
PORT=8787

{
  "name": "ridescope-postgres-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server/index.js\"",
    "db:import": "node scripts/import-csv.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./server/index.js')\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@webgpu/types": "^0.1.65",
    "concurrently": "^9.1.2",
    "csv-parse": "^7.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
